UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_BLOB_TOKEN=
# Use distinct namespaces and storage for isolated development/preview.
ARENA_NAMESPACE=arena:v1
# Production after verified migration: postgres. New empty local installs: redis.
ARENA_DATABASE_MODE=postgres
# Runpod/Jupyter/Hub keep Redis. Disable when unused; drain existing work first.
# enabled (default) | draining (callbacks/control only) | disabled
ARENA_RUNPOD_MODE=enabled
# Backend-only dedicated role, transaction pooler, port 6543. Never NEXT_PUBLIC_.
# postgresql://arena_backend.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
ARENA_DATABASE_URL=
# Optional trusted CA PEM override; Supabase pooler uses the bundled public CA.
ARENA_DATABASE_CA=
# Optional override for production tools (or use --base=...). Default: https://olpaiarena.cyou
ARENA_BASE_URL=
# Server-only: base64 of 32 random bytes. Keep stable; losing it loses stored Runpod/Groq credentials.
GPU_WORKSPACE_ENCRYPTION_KEY=
# Canonical public HTTPS origin, reachable from Runpod (production, not localhost).
GPU_WORKSPACE_PUBLIC_URL=
# On Render: use https://olpaiarena.cyou (or the service's onrender.com origin).
# Select the active deployment for callbacks; existing Pods keep their own environment.
# Build/push gpu-workspace/Dockerfile first; prefer an immutable digest in saved templates.
RUNPOD_WORKSPACE_IMAGE=nguyenlong26/olpai-workspace:2026.10.30-hub
# Set only after the Hub image passes Linux/browser CI and is published.
RUNPOD_HUB_IMAGE=
# Additional exact HTTPS origins of the same Arena app, comma-separated.
# Keeps Hub login on the domain where the browser's Arena session exists.
GPU_WORKSPACE_LOGIN_ORIGINS=

# Self-hosted Node Groq queue runner (automatic on Render). Enable locally for QA.
GROQ_RUNNER_ENABLED=false
