UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_BLOB_TOKEN=
# Use distinct namespaces and storage for isolated development/preview.
ARENA_NAMESPACE=arena:v1
# Server-only: base64 of 32 random bytes. Keep stable; losing it loses stored Runpod credentials.
GPU_WORKSPACE_ENCRYPTION_KEY=
# Canonical public HTTPS origin, reachable from Runpod (production, not localhost).
GPU_WORKSPACE_PUBLIC_URL=
# Build/push gpu-workspace/Dockerfile first; prefer an immutable digest in saved templates.
RUNPOD_WORKSPACE_IMAGE=nguyenlong26/olpai-workspace:2026.10.27
# Set only after the Hub image passes Linux/browser CI and is published.
RUNPOD_HUB_IMAGE=
# Additional exact HTTPS origins of the same Arena app, comma-separated.
# Keeps Hub login on the domain where the browser's Arena session exists.
GPU_WORKSPACE_LOGIN_ORIGINS=
